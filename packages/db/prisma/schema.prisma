// TicketApp core data model. See docs/build-plan.md ("Core data model").
// Money is stored as integer cents. Times are stored in UTC.

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─── Organizations and staff ────────────────────────────────────────────────

model District {
  id            String         @id @default(uuid(7)) @db.Uuid
  name          String
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  organizations Organization[]
}

/// Who covers the card processing fee on online orders.
enum FeePayer {
  BUYER
  ORGANIZATION
}

enum OrganizationType {
  SCHOOL
  COMMITTEE
  NONPROFIT
}

model Organization {
  id                     String           @id @default(uuid(7)) @db.Uuid
  name                   String
  slug                   String           @unique
  type                   OrganizationType
  timezone               String           @default("America/New_York")
  districtId             String?          @db.Uuid
  district               District?        @relation(fields: [districtId], references: [id])
  stripeAccountId        String?          @unique
  /// Cached from the Stripe account so checkout can tell whether the org can take payments.
  stripeChargesEnabled   Boolean          @default(false)
  stripePayoutsEnabled   Boolean          @default(false)
  stripeDetailsSubmitted Boolean          @default(false)
  /// Whether stripeAccountId was made with a live key; a test account is useless once live.
  stripeLivemode         Boolean?
  cardFeePaidBy          FeePayer         @default(ORGANIZATION)
  /// Who covers the platform's per-ticket service fee.
  serviceFeePaidBy       FeePayer         @default(BUYER)
  createdAt              DateTime         @default(now())
  updatedAt              DateTime         @updatedAt
  memberships            Membership[]
  invitations            Invitation[]
  events                 Event[]
  waiverTemplates        WaiverTemplate[]

  @@index([districtId])
}

model User {
  id              String       @id @default(uuid(7)) @db.Uuid
  email           String       @unique
  name            String
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  memberships     Membership[]
  scans           ScanEvent[]
  sessions        Session[]
  invitations     Invitation[]
  compOrders      Order[]      @relation("CompedBy")
  cancelledOrders Order[]      @relation("CancelledBy")
}

/// One-time sign-in link. Only the SHA-256 of the token is stored.
model MagicLinkToken {
  id         String    @id @default(uuid(7)) @db.Uuid
  email      String
  /// Display name supplied at sign-up; used if no user exists yet for this email.
  name       String?
  tokenHash  String    @unique
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([email, createdAt])
}

/// Signed-in staff session (web cookie or mobile bearer token). Only the SHA-256 is stored.
model Session {
  id         String    @id @default(uuid(7)) @db.Uuid
  userId     String    @db.Uuid
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash  String    @unique
  expiresAt  DateTime
  revokedAt  DateTime?
  userAgent  String?
  createdAt  DateTime  @default(now())
  lastUsedAt DateTime  @default(now())

  @@index([userId])
}

enum Role {
  OWNER
  ADMIN
  DOOR_STAFF
  VIEWER
}

model Membership {
  id             String       @id @default(uuid(7)) @db.Uuid
  userId         String       @db.Uuid
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organizationId String       @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  role           Role
  createdAt      DateTime     @default(now())

  @@unique([userId, organizationId])
  @@index([organizationId])
}

/// Invitation to join an organization. Accepting it proves the invitee owns the email, so it
/// also signs them in. Only the SHA-256 of the token is stored.
model Invitation {
  id             String       @id @default(uuid(7)) @db.Uuid
  organizationId String       @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  email          String
  role           Role
  tokenHash      String       @unique
  invitedById    String?      @db.Uuid
  invitedBy      User?        @relation(fields: [invitedById], references: [id], onDelete: SetNull)
  expiresAt      DateTime
  acceptedAt     DateTime?
  revokedAt      DateTime?
  createdAt      DateTime     @default(now())

  @@index([organizationId, email])
  @@index([email, createdAt])
  @@index([invitedById, createdAt])
}

// ─── Events and tickets ─────────────────────────────────────────────────────

enum EventStatus {
  DRAFT
  PUBLISHED
  CANCELLED
}

model Event {
  id             String        @id @default(uuid(7)) @db.Uuid
  organizationId String        @db.Uuid
  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  slug           String
  description    String?
  venue          String?
  startsAt       DateTime
  endsAt         DateTime
  capacity       Int?
  status         EventStatus   @default(DRAFT)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  ticketTypes    TicketType[]
  promoCodes     PromoCode[]
  orders         Order[]
  tickets        Ticket[]
  waivers        EventWaiver[]
  scans          ScanEvent[]

  @@unique([organizationId, slug])
  @@index([organizationId, startsAt])
}

model TicketType {
  id               String      @id @default(uuid(7)) @db.Uuid
  eventId          String      @db.Uuid
  event            Event       @relation(fields: [eventId], references: [id], onDelete: Cascade)
  name             String
  priceCents       Int
  quantity         Int?
  maxPerOrder      Int         @default(10)
  salesStartAt     DateTime?
  salesEndAt       DateTime?
  /// Only students may buy. Checked against the buyer's details at checkout (and the roster, once E6.2 lands).
  studentsOnly     Boolean     @default(false)
  /// Inclusive grade range for students-only tickets; null means no limit on that side.
  minGrade         Int?
  maxGrade         Int?
  /// Guest passes: each purchase waits for staff approval before the ticket is valid.
  requiresApproval Boolean     @default(false)
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt
  tickets          Ticket[]
  promoCodes       PromoCode[]

  @@index([eventId])
}

enum DiscountType {
  PERCENT
  AMOUNT
}

/// A discount buyers enter at checkout. `code` is stored upper-case and unique within the event.
model PromoCode {
  id            String       @id @default(uuid(7)) @db.Uuid
  eventId       String       @db.Uuid
  event         Event        @relation(fields: [eventId], references: [id], onDelete: Cascade)
  code          String
  discountType  DiscountType
  /// Whole percent (1–100) for PERCENT, cents off the order for AMOUNT.
  discountValue Int
  /// Orders that may use it; null means unlimited.
  maxUses       Int?
  validFrom     DateTime?
  validUntil    DateTime?
  active        Boolean      @default(true)
  /// Ticket types it applies to; empty means all of the event's types.
  ticketTypes   TicketType[]
  orders        Order[]
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@unique([eventId, code])
}

enum OrderStatus {
  PENDING
  PAID
  REFUNDED
  CANCELLED
}

enum PaymentMethod {
  CARD
  CASH
  COMP
}

model Order {
  id                       String        @id @default(uuid(7)) @db.Uuid
  eventId                  String        @db.Uuid
  event                    Event         @relation(fields: [eventId], references: [id], onDelete: Restrict)
  buyerName                String
  buyerEmail               String
  buyerPhone               String?
  status                   OrderStatus   @default(PENDING)
  paymentMethod            PaymentMethod @default(CARD)
  subtotalCents            Int
  discountCents            Int           @default(0)
  promoCodeId              String?       @db.Uuid
  promoCode                PromoCode?    @relation(fields: [promoCodeId], references: [id], onDelete: Restrict)
  /// Who on staff issued a comp order.
  compedById               String?       @db.Uuid
  compedBy                 User?         @relation("CompedBy", fields: [compedById], references: [id], onDelete: SetNull)
  note                     String?
  /// Card fee added to what the buyer pays; zero when the organization covers it.
  feeCents                 Int           @default(0)
  /// Our estimate of Stripe's fee, kept back from the organization's share when it covers the fee.
  processingFeeCents       Int           @default(0)
  /// Service fee added to what the buyer pays; zero when the organization covers it.
  serviceFeeCents          Int           @default(0)
  /// The service fee the platform keeps from the payment, whoever covers it.
  platformFeeCents         Int           @default(0)
  totalCents               Int
  /// SHA-256 of the key in the buyer's order link; the link is the only way to see the order.
  viewKeyHash              String?       @unique
  /// Seats stay held for an unpaid order until this time.
  holdExpiresAt            DateTime?
  stripeCheckoutSessionId  String?       @unique
  stripePaymentIntentId    String?       @unique
  /// When the provider accepted the confirmation email with the tickets.
  confirmationSentAt       DateTime?
  /// Set while a send is in progress; a claim older than a few minutes was abandoned and can be retaken.
  confirmationClaimedAt    DateTime?
  /// The first attempt. Retries stop a day later, while the provider still remembers it.
  confirmationFirstTriedAt DateTime?
  /// Send attempts so far; retries stop after a few.
  confirmationAttempts     Int           @default(0)
  /// The order link's key, kept only until the confirmation email carries it to the buyer.
  emailViewKey             String?
  /// The confirmation email as first rendered, so every retry sends the same message under the
  /// same idempotency key even if the event changes. Cleared with the key.
  confirmationEmail        Json?
  /// When staff cancelled the order from the dashboard, refunding it if it was paid for.
  cancelledAt              DateTime?
  cancelledById            String?       @db.Uuid
  cancelledBy              User?         @relation("CancelledBy", fields: [cancelledById], references: [id], onDelete: SetNull)
  /// What went back to the buyer's card.
  refundedCents            Int           @default(0)
  stripeRefundId           String?       @unique
  /// Stripe's status for the refund when it was made. Card refunds can stay pending for a while;
  /// webhooks (E4.6) will follow the ones that do.
  stripeRefundStatus       String?
  /// The cancellation email, kept until the provider accepts it so a failed send can be retried.
  cancellationEmail        Json?
  /// Set while a cancellation email is being sent; one older than a few minutes was abandoned.
  cancellationClaimedAt    DateTime?
  /// Cancellation email attempts so far; retries stop after a few.
  cancellationAttempts     Int           @default(0)
  createdAt                DateTime      @default(now())
  updatedAt                DateTime      @updatedAt
  tickets                  Ticket[]

  @@index([eventId, status])
  @@index([buyerEmail])
  @@index([promoCodeId])
}

enum TicketStatus {
  /// Reserved while the buyer pays; takes a seat until the order's hold expires.
  HELD
  VALID
  VOID
}

/// One per attendee. `code` is what the QR encodes; it is random, never guessable.
model Ticket {
  id           String            @id @default(uuid(7)) @db.Uuid
  code         String            @unique
  orderId      String            @db.Uuid
  order        Order             @relation(fields: [orderId], references: [id], onDelete: Cascade)
  eventId      String            @db.Uuid
  event        Event             @relation(fields: [eventId], references: [id], onDelete: Restrict)
  ticketTypeId String            @db.Uuid
  ticketType   TicketType        @relation(fields: [ticketTypeId], references: [id], onDelete: Restrict)
  attendeeId   String            @db.Uuid
  attendee     Attendee          @relation(fields: [attendeeId], references: [id], onDelete: Restrict)
  status       TicketStatus      @default(VALID)
  /// Denormalised from the latest scan so the door app can answer in one read.
  isInside     Boolean           @default(false)
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  signatures   WaiverSignature[]
  scans        ScanEvent[]

  @@unique([eventId, attendeeId])
  @@index([eventId, isInside])
}

// ─── Attendees and guardians ────────────────────────────────────────────────

model Attendee {
  id               String             @id @default(uuid(7)) @db.Uuid
  firstName        String
  lastName         String
  email            String?
  phone            String?
  dateOfBirth      DateTime?          @db.Date
  grade            Int?
  studentId        String?
  emergencyContact String?
  medicalNotes     String?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  tickets          Ticket[]
  guardians        AttendeeGuardian[]
}

model Guardian {
  id            String             @id @default(uuid(7)) @db.Uuid
  name          String
  email         String?
  phone         String?
  /// When the guardian agreed to receive check-in/out texts (TCPA consent). Null = no texts.
  smsOptInAt    DateTime?
  smsOptOutAt   DateTime?
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
  attendees     AttendeeGuardian[]
  signatures    WaiverSignature[]
  notifications Notification[]
}

model AttendeeGuardian {
  attendeeId   String   @db.Uuid
  attendee     Attendee @relation(fields: [attendeeId], references: [id], onDelete: Cascade)
  guardianId   String   @db.Uuid
  guardian     Guardian @relation(fields: [guardianId], references: [id], onDelete: Cascade)
  relationship String?
  /// Whether this guardian gets check-in/out texts for this attendee.
  notify       Boolean  @default(true)

  @@id([attendeeId, guardianId])
  @@index([guardianId])
}

// ─── Waivers ────────────────────────────────────────────────────────────────

model WaiverTemplate {
  id                        String            @id @default(uuid(7)) @db.Uuid
  organizationId            String            @db.Uuid
  organization              Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  title                     String
  body                      String
  version                   Int               @default(1)
  requiresGuardianForMinors Boolean           @default(true)
  createdAt                 DateTime          @default(now())
  updatedAt                 DateTime          @updatedAt
  events                    EventWaiver[]
  signatures                WaiverSignature[]

  @@index([organizationId])
}

model EventWaiver {
  eventId          String         @db.Uuid
  event            Event          @relation(fields: [eventId], references: [id], onDelete: Cascade)
  waiverTemplateId String         @db.Uuid
  waiverTemplate   WaiverTemplate @relation(fields: [waiverTemplateId], references: [id], onDelete: Restrict)

  @@id([eventId, waiverTemplateId])
}

enum SignerRole {
  ATTENDEE
  GUARDIAN
}

/// Audit trail for one signature. `documentHash` is the SHA-256 of the exact text signed.
model WaiverSignature {
  id               String         @id @default(uuid(7)) @db.Uuid
  ticketId         String         @db.Uuid
  ticket           Ticket         @relation(fields: [ticketId], references: [id], onDelete: Restrict)
  waiverTemplateId String         @db.Uuid
  waiverTemplate   WaiverTemplate @relation(fields: [waiverTemplateId], references: [id], onDelete: Restrict)
  templateVersion  Int
  signerRole       SignerRole
  signerName       String
  guardianId       String?        @db.Uuid
  guardian         Guardian?      @relation(fields: [guardianId], references: [id], onDelete: SetNull)
  signedAt         DateTime       @default(now())
  ipAddress        String?
  userAgent        String?
  documentHash     String
  pdfStorageKey    String?

  @@unique([ticketId, waiverTemplateId, signerRole])
}

// ─── Door scans and notifications ───────────────────────────────────────────

enum ScanDirection {
  IN
  OUT
}

/// Mirrors ScanOutcome in @ticketapp/shared.
enum ScanOutcome {
  ADMITTED
  CHECKED_OUT
  ALREADY_INSIDE
  NOT_INSIDE
  WAIVER_MISSING
  INVALID_TICKET
}

model ScanEvent {
  id             String         @id @default(uuid(7)) @db.Uuid
  eventId        String         @db.Uuid
  event          Event          @relation(fields: [eventId], references: [id], onDelete: Cascade)
  ticketId       String?        @db.Uuid
  ticket         Ticket?        @relation(fields: [ticketId], references: [id], onDelete: SetNull)
  direction      ScanDirection
  outcome        ScanOutcome
  /// Set when staff let someone in despite a blocking outcome.
  overrideReason String?
  staffUserId    String?        @db.Uuid
  staffUser      User?          @relation(fields: [staffUserId], references: [id], onDelete: SetNull)
  deviceId       String?
  /// When the scan happened on the device; differs from createdAt for offline scans.
  scannedAt      DateTime
  createdAt      DateTime       @default(now())
  notifications  Notification[]

  @@index([eventId, scannedAt])
  @@index([ticketId])
}

enum NotificationChannel {
  SMS
  EMAIL
}

enum NotificationStatus {
  QUEUED
  SENT
  DELIVERED
  FAILED
}

model Notification {
  id                String              @id @default(uuid(7)) @db.Uuid
  guardianId        String?             @db.Uuid
  guardian          Guardian?           @relation(fields: [guardianId], references: [id], onDelete: SetNull)
  scanEventId       String?             @db.Uuid
  scanEvent         ScanEvent?          @relation(fields: [scanEventId], references: [id], onDelete: SetNull)
  channel           NotificationChannel
  to                String
  body              String
  status            NotificationStatus  @default(QUEUED)
  providerMessageId String?             @unique
  error             String?
  attempts          Int                 @default(0)
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  @@index([status])
  @@index([scanEventId])
}
