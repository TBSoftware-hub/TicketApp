# Local Postgres for development and tests. CI sets its own DATABASE_URL.
WEB_BASE_URL="http://localhost:3000"
DATABASE_URL="postgresql://ticketapp:ticketapp@localhost:5432/ticketapp?schema=public"
# Leave RESEND_API_KEY and SMTP_URL unset locally: sign-in emails are written to the API log.
# RESEND_API_KEY="re_..."
# SMTP_URL="smtps://user:password@smtp.example.com:465"
# MAIL_FROM="TicketApp <tickets@example.com>"
# Stripe test-mode key for the Connect platform. Unset, payout setup says payments are off.
# STRIPE_SECRET_KEY="sk_test_..."
# Twilio, for texting guardians their waiver link. Unset locally, texts are written to the API log.
# TWILIO_ACCOUNT_SID="AC..."
# TWILIO_AUTH_TOKEN="..."
# TWILIO_FROM="+15551234567"
# Secret for hashing the door app's sign-in codes. Unset locally, a fixed development key is used.
# SIGN_IN_CODE_KEY="..."
